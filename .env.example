# Copy to .env and edit. Every variable is optional except the token and admins.
# The bot refuses to start without UWP_BOT_TOKEN.

# --- Telegram -----------------------------------------------------------------
# Token from @BotFather.
UWP_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (see /id).
UWP_ADMIN_IDS=
# Proxy for Bot API calls only (scraping keeps its own per-site proxies).
# Needed where api.telegram.org is unreachable; without it aiogram dies with
# TelegramNetworkError and the container restart-loops.
#   socks5://host:port      needs the aiohttp-socks package (ships in the image)
#   http://user:pass@host:port
# A proxy on the host's 127.0.0.1 is NOT reachable from a bridged container:
# run with `-f compose.yaml -f compose.hostnet.yaml` or use the host's LAN address.
UWP_TELEGRAM_PROXY=
# Timezone for every date shown in the bot and in reports.
UWP_TZ=Europe/Moscow
# Language of the bot, the CLI and (by default) reports: ru or en.
UWP_DEFAULT_LANGUAGE=ru
# Reports may use a different language than the interface. Empty = the value
# of UWP_DEFAULT_LANGUAGE. The worker writes reports, so this is deployment-wide,
# not per admin.
UWP_REPORT_LANGUAGE=
# Discard commands that were sent while the bot was down. With `true` a command
# typed during a restart is never replayed; set to `false` to deliver the
# backlog on the next start (the bot then answers stale button presses too).
UWP_DROP_PENDING_UPDATES=true

# --- Storage ------------------------------------------------------------------
# Inside Docker this is the mounted volume.
UWP_DATA_DIR=data
# How many .ods reports to keep per site before old ones are pruned.
UWP_EXPORTS_RETENTION=50
# How many per-run artifact directories (screenshots of failed runs) to keep.
UWP_ARTIFACTS_RETENTION=20
# How long undelivered bot events are kept, in days.
UWP_EVENT_TTL_DAYS=3
# Report file name. Placeholders: {parser_title}, {site_name}, {timestamp}.
# Substituted values are slugified and path separators are stripped, so a
# template cannot write outside ./exports.
# UWP_REPORT_NAME_TEMPLATE={parser_title}_{site_name}_{timestamp}

# --- Secrets ------------------------------------------------------------------
# A long random string (the output of `openssl rand -hex 32`, pasted here) used
# to encrypt proxy passwords and VNC session passwords at rest. This file is read
# as plain text, not as a shell script: writing `UWP_SECRET_KEY=$(openssl ...)`
# stores that literal text as the key — it passes the length check, and it is
# printed on the install page, so it protects nothing. `${VAR}` *is* expanded by
# Compose, so `UWP_SECRET_KEY=${MY_KEY}` works. Without a key the passwords are
# stored in plaintext and `uwp doctor` warns. The key is stretched with PBKDF2,
# so a leaked database is not a fast offline oracle — but a short or guessable
# key still falls.
UWP_SECRET_KEY=

# --- Browser ------------------------------------------------------------------
# Path to the fingerprint-chromium binary inside the image.
UWP_BROWSER_PATH=/opt/uwp/browser/chrome
# Pinned build; matches the sha256 verified by `uwp browser install`.
UWP_BROWSER_VERSION=148.0.7778.215
UWP_BROWSER_SHA256=70d239830332e5820aa34dfcb284161cac0429eee25da642830afe04bda717f4
# Archive `uwp browser install` downloads when you do not pass --url.
# UWP_BROWSER_URL=
# Chromium builds its own sandbox; compose mounts docker/seccomp-uwp.json to
# allow it. Only set this to true if you cannot use that profile — the renderer
# then shares the container's namespaces and can read /data and the bot token.
# UWP_NO_SANDBOX=false
# Parsing is headless; VNC login is always headful under Xvfb.
UWP_HEADLESS=true
UWP_PAGE_TIMEOUT_MS=30000
UWP_NAVIGATION_TIMEOUT_MS=60000

# --- Runs ---------------------------------------------------------------------
# How many sites may be scraped at once. Keep 1 unless memory allows more.
UWP_MAX_PARALLEL_RUNS=1
# Hard limit for one run, in seconds.
UWP_RUN_TIMEOUT=300
# Worker heartbeat period and the age after which a job is considered orphaned.
UWP_HEARTBEAT_INTERVAL=15
UWP_ORPHAN_THRESHOLD=90

# --- VNC ----------------------------------------------------------------------
# Port range published by compose for the noVNC web UI. It is published on the
# host's 127.0.0.1 only: noVNC is plain HTTP. For remote access use an SSH
# tunnel or a TLS reverse proxy (then set UWP_PUBLIC_SCHEME=https).
UWP_VNC_PORT_MIN=6000
UWP_VNC_PORT_MAX=6100
# Hard limit for a login session and the idle timeout.
UWP_VNC_TTL_MINUTES=60
UWP_VNC_IDLE_MINUTES=20
# Keep finished VNC session rows for this many days; their password is blanked
# as soon as the session stops.
UWP_VNC_HISTORY_DAYS=7
# Hostname or IP the admin's browser uses to reach noVNC.
UWP_PUBLIC_HOST=localhost
# http, or https when a TLS reverse proxy fronts the VNC ports.
UWP_PUBLIC_SCHEME=http
# Address websockify (the noVNC listener) binds inside the container.
# 0.0.0.0 is right for a bridged container: Docker's proxy dials the container
# address, not its loopback. compose.hostnet.yaml overrides it with 127.0.0.1,
# because host networking puts it straight onto every host interface.
# UWP_VNC_LISTEN_HOST=0.0.0.0

# --- Logging ------------------------------------------------------------------
UWP_LOG_LEVEL=INFO
